#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 2
python3 -m harness check --staged >/dev/null || { python3 -m harness check --staged; echo "pre-commit: fix the above or commit with --no-verify and say why in the message." >&2; exit 2; }
